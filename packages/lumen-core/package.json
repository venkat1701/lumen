{
  "name": "lumen-core",
  "version": "1.0.0",
  "description": "Lumen: a Markdown superset for research writing. Parser, compiler and plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.16.22",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-directive": "^3.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^3.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "^6.0.1",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
